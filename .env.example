# Vercel / Terra Z publishing backend

# Auth do editor
# Preferido: hash SHA-256 hexadecimal da senha.
EDITOR_PASSWORD_HASH=
# Alternativa temporária (não use junto com HASH):
# EDITOR_PASSWORD=

# Segredo HMAC para assinar sessões de editor.
# Gere um valor aleatório longo.
EDITOR_AUTH_SECRET=

# GitHub — opção rápida: fine-grained PAT restrito apenas ao repo Nierusen34/terra-z
# Permissão necessária: Contents = Read and write
GITHUB_TOKEN=

# Alternativa recomendada a longo prazo: GitHub App
# GITHUB_APP_ID=
# GITHUB_INSTALLATION_ID=
# GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

GITHUB_REPOSITORY=Nierusen34/terra-z
GITHUB_BRANCH=main

# Origem pública do site. Separe múltiplas origens por vírgula.
ALLOWED_ORIGINS=https://nierusen34.github.io

# Conteúdo mestre realmente privado.
# Deve ser JSON válido em uma única variável.
# Exemplo:
# {"characters":{"Tristan Queen":{"secrets":["..."]}}}
MASTER_CONTENT_JSON=
