{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    }
  },
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/api/master-template",
      "destination": "/api/master?action=template"
    },
    {
      "source": "/api/master-finalize",
      "destination": "/api/master?action=finalize"
    },
    {
      "source": "/api/private-sessions",
      "destination": "/api/session?action=private"
    },
    {
      "source": "/api/status",
      "destination": "/api/health?mode=status"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
